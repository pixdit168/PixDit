# Runtime
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:8000
TRUST_PROXY=false
GENERATED_DIR=generated

# Premium image provider
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-2-pro
REPLICATE_SAFETY_TOLERANCE=2
REPLICATE_OUTPUT_QUALITY=90
REPLICATE_TIMEOUT_MS=300000

# Free image provider. Fill NINEROUTER_IMAGE_MODEL after selecting a model
# returned by GET $NINEROUTER_URL/v1/models/image.
NINEROUTER_API_KEY=
NINEROUTER_URL=https://api.9router.com
NINEROUTER_IMAGE_MODEL=
NINEROUTER_TIMEOUT_MS=300000
NINEROUTER_OUTPUT_QUALITY=90

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
