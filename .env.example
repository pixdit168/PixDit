# Runtime
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:8000
TRUST_PROXY=false

# Replicate agents
REPLICATE_API_TOKEN=
REPLICATE_FREE_MODEL=sourceful/riverflow-2.0-pro
REPLICATE_PRO_MODEL=openai/gpt-image-2
# Optional background removal (same server token). Generation uses no AI planner.
REPLICATE_BG_REMOVE_MODEL=bria/remove-background
REPLICATE_SAFETY_TOLERANCE=2
REPLICATE_OUTPUT_QUALITY=90
REPLICATE_TIMEOUT_MS=600000

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_IMAGE_BUCKET=layera-generated
