{
  "name": "layera",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "api/index.js",
  "description": "Layera image campaign generator with Agent Free and Agent Pro on Replicate.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.node.json && tsc -p tsconfig.browser.json",
    "postinstall": "npm run build",
    "start": "node app-backend.js",
    "predev": "npm run build",
    "dev": "concurrently -k \"tsc --watch -p tsconfig.node.json\" \"tsc --watch -p tsconfig.browser.json\" \"node --watch app-backend.js\"",
    "check": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "preconfigure:supabase": "npm run build",
    "configure:supabase": "node scripts/configure-supabase.mjs",
    "premigrate:supabase": "npm run build",
    "migrate:supabase": "node scripts/migrate-to-supabase.mjs",
    "preverify:supabase-storage": "npm run build",
    "verify:supabase-storage": "node scripts/verify-supabase-storage.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/creative-agents.test.js tests/deployment-contract.test.js tests/replicate-resize.test.js tests/server-contract.test.js tests/supabase-storage.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "replicate": "^1.4.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "typescript": "~5.9.3"
  }
}
