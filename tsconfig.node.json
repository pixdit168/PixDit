{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["app-backend.ts", "api/**/*.ts", "lib/**/*.ts", "scripts/**/*.mts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
